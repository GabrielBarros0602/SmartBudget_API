# Normalise line endings so the repo stays clean across Windows and Linux.
# Everything is stored with LF in git; Windows checkouts stay LF too, which is
# what Python, Docker and GitHub Actions all expect.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they break when double-clicked.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
