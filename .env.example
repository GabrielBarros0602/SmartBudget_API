# Copy this file to .env and adjust the values.
# .env is git-ignored on purpose: never commit real secrets.

APP_NAME="SmartBudget API"
ENVIRONMENT=development
VERSION=0.1.0

# Added in S1 (PostgreSQL via Docker):
POSTGRES_USER=smartbudget
POSTGRES_PASSWORD=smartbudget
POSTGRES_DB=smartbudget
DATABASE_URL=postgresql+psycopg://smartbudget:smartbudget@localhost:5432/smartbudget

